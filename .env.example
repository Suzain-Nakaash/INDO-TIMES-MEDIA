# ========================================
# IndoTimesMedia — Environment Variables
# ========================================

# Server
NODE_ENV=development
PORT=5000
API_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://indotimes:indotimes_secret@localhost:5432/indotimesmedia?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_ACCESS_SECRET=your-access-token-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-token-secret-min-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Admin Seed Credentials
ADMIN_EMAIL=admin@indotimesmedia.com
ADMIN_PASSWORD=Admin@123456

# Cloudinary (for images & videos)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# S3-Compatible Storage (MinIO for local, AWS S3 for production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=indotimesmedia
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=debug

# SEO
SITE_NAME=IndoTimesMedia
SITE_URL=https://indotimesmedia.com
SITE_DESCRIPTION=India's premier digital news platform
